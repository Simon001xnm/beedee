{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Comprehensive user profile with role-based permissions and activity auditing.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["Super Admin", "Manager", "Cashier", "Inventory Manager", "Customer Support", "Customer"] 
        },
        "isActive": { "type": "boolean" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "loginHistory": { 
          "type": "array", 
          "items": { "type": "string", "format": "date-time" } 
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Master inventory product details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "stockCount": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "UserProfile", "description": "System users and roles." },
    "/products/{productId}": { "schema": "Product", "description": "Master product catalog." },
    "/categories/{categoryId}": { "schema": { "type": "object" }, "description": "Product departments." },
    "/orders/{orderId}": { "schema": { "type": "object" }, "description": "Customer orders and fulfillment." },
    "/customers/{customerId}": { "schema": { "type": "object" }, "description": "Customer demographic records." },
    "/inventory/{itemId}": { "schema": { "type": "object" }, "description": "Stock tracking and adjustments." },
    "/payments/{paymentId}": { "schema": { "type": "object" }, "description": "Payment gateway history." },
    "/transactions/{txnId}": { "schema": { "type": "object" }, "description": "Financial ledger and accounting." },
    "/website/{configId}": { "schema": { "type": "object" }, "description": "Site-wide UI configurations." },
    "/settings/{settingId}": { "schema": { "type": "object" }, "description": "Global system variables." },
    "/pages/{pageId}": { "schema": { "type": "object" }, "description": "CMS page content." },
    "/reports/{reportId}": { "schema": { "type": "object" }, "description": "Analytics and business intelligence." },
    "/reviews/{reviewId}": { "schema": { "type": "object" }, "description": "User feedback and ratings." },
    "/notifications/{notifId}": { "schema": { "type": "object" }, "description": "System and user alerts." }
  }
}